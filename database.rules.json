{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'dog', 'lastSeen'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "dog": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "breed": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "park": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name','dog','breed','x','z','dx','dz','t'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "dog": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "breed": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "ear": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "tail": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "hair": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "shirt": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "coat": {
          ".validate": "newData.isNumber()"
        },
        "eye": {
          ".validate": "newData.isNumber()"
        },
        "h": {
          ".validate": "newData.isNumber()"
        },
        "x": {
          ".validate": "newData.isNumber() && newData.val() >= -20 && newData.val() <= 130"
        },
        "z": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 40"
        },
        "dx": {
          ".validate": "newData.isNumber() && newData.val() >= -20 && newData.val() <= 130"
        },
        "dz": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 40"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}