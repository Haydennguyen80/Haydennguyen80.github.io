{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'dog', 'lastSeen'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "dog": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "breed": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        },
        "created": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "playSec": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "terms": {
          ".validate": "newData.hasChildren(['v','at'])",
          "v": {
            ".validate": "newData.isNumber()"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      ".read": "auth != null && auth.uid === 'gHUDp3jCTYUfy5RiPuCdpv5Dwz02'"
    },
    "park": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name','dog','breed','x','z','dx','dz','t'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "dog": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "breed": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "ear": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "tail": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "hair": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "shirt": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "coat": {
          ".validate": "newData.isNumber()"
        },
        "eye": {
          ".validate": "newData.isNumber()"
        },
        "h": {
          ".validate": "newData.isNumber()"
        },
        "x": {
          ".validate": "newData.isNumber() && newData.val() >= -20 && newData.val() <= 130"
        },
        "z": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 40"
        },
        "dx": {
          ".validate": "newData.isNumber() && newData.val() >= -20 && newData.val() <= 130"
        },
        "dz": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 40"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        },
        "pants": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        }
      }
    },
    "activity": {
      ".read": "auth != null && auth.uid === 'gHUDp3jCTYUfy5RiPuCdpv5Dwz02'",
      "$day": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
        }
      }
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['data','at'])",
        "data": {
          ".validate": "newData.isString() && newData.val().length <= 500000"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "friendReq": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".validate": "newData.hasChildren(['name','dog','t'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "dog": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          },
          ".write": "auth != null && ((auth.uid === $from && $from !== $to && (!newData.exists() || (!data.exists() && !root.child('blocks/' + $to + '/' + $from).exists() && !root.child('friends/' + $to + '/' + $from).exists() && root.child('users/' + $from).exists()))) || (auth.uid === $to && !newData.exists()))"
        }
      }
    },
    "friendSent": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$to": {
          ".validate": "newData.hasChildren(['name','dog','t'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "dog": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          },
          ".write": "auth != null && auth.uid === $to && !newData.exists()"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$other": {
          ".validate": "newData.hasChildren(['name','dog','t'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "dog": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          },
          ".write": "auth != null && $uid !== $other && (auth.uid === $uid || auth.uid === $other) && (!newData.exists() || (auth.uid === $uid && root.child('friendReq/' + $uid + '/' + $other).exists()) || (auth.uid === $other && root.child('friendReq/' + $other + '/' + $uid).exists()))"
        }
      }
    },
    "blocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$other": {
          ".validate": "newData.hasChildren(['name','t']) && $other !== $uid",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "dog": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$x": {
            ".validate": false
          }
        }
      }
    },
    "reports": {
      ".read": "auth != null && auth.uid === 'gHUDp3jCTYUfy5RiPuCdpv5Dwz02'",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || (auth.uid === 'gHUDp3jCTYUfy5RiPuCdpv5Dwz02' && !newData.exists()))",
        ".validate": "newData.hasChildren(['from','about','aboutName','reason','t'])",
        "from": {
          ".validate": "newData.isString()"
        },
        "about": {
          ".validate": "newData.isString() && newData.val().length <= 128 && newData.val() !== auth.uid"
        },
        "aboutName": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "aboutDog": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "reason": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$x": {
          ".validate": false
        }
      }
    },
    "chats": {
      "$a": {
        "$b": {
          ".read": "auth != null && (auth.uid === $a || auth.uid === $b)",
          ".write": "auth != null && (auth.uid === $a || auth.uid === $b) && !newData.exists()",
          "$mid": {
            ".write": "auth != null && !data.exists() && $a < $b && (auth.uid === $a || auth.uid === $b) && newData.child('from').val() === auth.uid && root.child('friends/' + $a + '/' + $b).exists() && root.child('friends/' + $b + '/' + $a).exists() && !root.child('blocks/' + $a + '/' + $b).exists() && !root.child('blocks/' + $b + '/' + $a).exists()",
            ".validate": "newData.hasChildren(['from','text','t'])",
            "from": {
              ".validate": "newData.isString()"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 600000"
            },
            "$x": {
              ".validate": false
            }
          }
        }
      }
    },
    "inbox": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        ".write": "auth != null && auth.uid === $to && !newData.exists()",
        "$from": {
          ".write": "auth != null && ((auth.uid === $from && $from !== $to && root.child('friends/' + $to + '/' + $from).exists() && !root.child('blocks/' + $to + '/' + $from).exists()) || (auth.uid === $to && !newData.exists()) || (auth.uid === $from && !newData.exists()))",
          ".validate": "newData.hasChildren(['name','t'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$x": {
            ".validate": false
          }
        }
      }
    }
  }
}